<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Paws &amp; Whiskers Pet Shop - Extend Class</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --night:#0e2a33; --night-2:#14414d; --bulb:#ffd37a; --mint:#7fd6c2;
    --blue:#5db8ff; --card:#f3f8f7; --ink:#17323a; --chalk:#e9f5ef; --board:#1d3b32;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0; min-height:100vh; color:var(--ink);
    font:400 1.05rem/1.6 "Nunito",system-ui,sans-serif;
    background:
      radial-gradient(900px 420px at 50% -80px, rgba(255,211,122,.28), transparent 70%),
      linear-gradient(180deg,var(--night) 0%,var(--night-2) 100%);
    background-attachment:fixed;
  }

  .lights{position:relative;height:46px;overflow:hidden}
  .lights::before,.lights::after{
    content:"";position:absolute;inset:0;
    background-repeat:repeat-x;background-size:64px 46px;
    animation:twinkle 3.2s ease-in-out infinite;
  }
  .lights::before{
    background-image:radial-gradient(circle at 16px 26px,var(--bulb) 0 5px,rgba(255,211,122,.35) 6px,transparent 13px);
  }
  .lights::after{
    background-image:radial-gradient(circle at 48px 26px,var(--mint) 0 5px,rgba(127,214,194,.35) 6px,transparent 13px);
    animation-delay:1.6s;
  }
  .lights i{position:absolute;left:0;right:0;top:8px;height:2px;background:#0a1d24;z-index:1;border-radius:2px}
  @keyframes twinkle{0%,100%{opacity:1}50%{opacity:.45}}

  .shop{
    text-align:center; padding:8px 20px 44px; color:#fff;
  }
  .window{
    width:min(260px,70vw); aspect-ratio:1; margin:6px auto 18px; border-radius:50%;
    background:radial-gradient(circle at 50% 40%,#2a6b7a 0%,#173f4b 70%);
    border:6px solid #0a1d24;
    box-shadow:0 0 0 3px var(--bulb),0 0 40px 8px rgba(255,211,122,.45),inset 0 0 40px rgba(0,0,0,.45);
    display:grid;place-items:center;overflow:hidden;
  }
  .window svg{width:92%;height:92%}
  .sign{
    font:600 clamp(2rem,6vw,3.2rem)/1.1 "Fredoka",sans-serif;
    margin:0;letter-spacing:.01em;
    color:#fff8e6;
    text-shadow:0 0 6px rgba(255,211,122,.9),0 0 22px rgba(255,211,122,.55);
  }
  .tag{margin:.6rem 0 0;color:#bfe3dc;font-weight:600}

  main{max-width:760px;margin:0 auto;padding:0 18px 60px;display:grid;gap:26px}
  .card{
    position:relative;background:var(--card);border-radius:22px;
    padding:30px clamp(18px,4vw,36px) 34px;
    border:1px solid rgba(255,255,255,.7);
    box-shadow:0 0 0 4px rgba(255,211,122,.18),0 18px 40px rgba(0,0,0,.35);
  }
  .card::before{ 
    content:"";position:absolute;left:22px;right:22px;top:-12px;height:14px;border-radius:12px 12px 0 0;
    background:repeating-linear-gradient(90deg,var(--mint) 0 28px,#fff 28px 56px);
    box-shadow:0 4px 8px rgba(0,0,0,.25);
  }
  .card h2{
    font:600 1.7rem/1.2 "Fredoka",sans-serif;color:var(--night-2);margin:.2rem 0 1rem;
  }
  .card h4{
    font:600 1.1rem/1.3 "Fredoka",sans-serif;color:#1b6a7a;margin:1.6rem 0 .6rem;
    padding-left:14px;border-left:5px solid var(--bulb);
  }
  .card a{
    color:#0f6f86;font-weight:700;text-decoration-thickness:2px;text-underline-offset:3px;
  }
  .card a:hover{color:#08485a;background:rgba(255,211,122,.35)}

  .card input[type=text]{
    font:600 1rem "Nunito",sans-serif;color:var(--ink);
    padding:9px 14px;margin:6px 0;min-width:min(100%,260px);
    background:#fff;border:2px dashed #9bcfc6;border-radius:12px;
  }
  .card input[type=text]:focus{outline:3px solid var(--blue);outline-offset:2px;border-style:solid}

  .card input[type=button]{
    font:600 1rem "Fredoka",sans-serif;color:#fff;cursor:pointer;
    margin:10px 0 6px;padding:12px 24px;border:0;border-radius:999px;
    background:linear-gradient(180deg,#2aa6b8,#16788a);
    box-shadow:0 4px 0 #0f5663,0 0 18px rgba(93,184,255,.45);
    transition:transform .12s,box-shadow .12s;
  }
  .card input[type=button]:hover{box-shadow:0 4px 0 #0f5663,0 0 26px rgba(255,211,122,.8)}
  .card input[type=button]:active{transform:translateY(3px);box-shadow:0 1px 0 #0f5663,0 0 18px rgba(93,184,255,.45)}
  .card input[type=button]:focus-visible{outline:3px solid var(--bulb);outline-offset:3px}

  .card div{ 
    margin-top:14px;min-height:64px;padding:16px 20px;border-radius:14px;
    background:var(--board);color:var(--chalk);
    font:600 1.15rem/1.5 "Fredoka",sans-serif;
    border:6px solid #8a5a35;
    box-shadow:inset 0 0 22px rgba(0,0,0,.45);
  }

  footer{text-align:center;color:#9cc7c0;padding:0 18px 40px;font-size:.95rem}

  @media (prefers-reduced-motion:reduce){
    .lights::before,.lights::after{animation:none}
    .card input[type=button]{transition:none}
  }
</style>
</head>
<body>

<header class="shop">
  <div class="lights"><i></i></div>
  <div class="window" role="img" aria-label="A grey cat with blue eyes">
    <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="fur" cx="50%" cy="38%" r="70%">
          <stop offset="0" stop-color="#c4c9d0"/><stop offset=".6" stop-color="#9aa1ab"/><stop offset="1" stop-color="#6f7782"/>
        </radialGradient>
        <radialGradient id="iris" cx="50%" cy="40%" r="60%">
          <stop offset="0" stop-color="#bfe8ff"/><stop offset=".55" stop-color="#4aa8f0"/><stop offset="1" stop-color="#1f6fc0"/>
        </radialGradient>
      </defs>
      <ellipse cx="120" cy="228" rx="86" ry="52" fill="url(#fur)"/>
      <ellipse cx="120" cy="214" rx="34" ry="34" fill="#e6e9ed" opacity=".85"/>
      <polygon points="58,100 64,30 114,66" fill="url(#fur)"/>
      <polygon points="182,100 176,30 126,66" fill="url(#fur)"/>
      <polygon points="70,86 73,48 100,68" fill="#e9a3b3"/>
      <polygon points="170,86 167,48 140,68" fill="#e9a3b3"/>
      <circle cx="120" cy="128" r="74" fill="url(#fur)"/>
      <path d="M120 56v22M104 60l5 18M136 60l-5 18" stroke="#6a717c" stroke-width="5" stroke-linecap="round" fill="none"/>
      <ellipse cx="120" cy="158" rx="30" ry="24" fill="#e6e9ed"/>
      <ellipse cx="90" cy="122" rx="19" ry="21" fill="#f4f7fa"/>
      <ellipse cx="150" cy="122" rx="19" ry="21" fill="#f4f7fa"/>
      <ellipse cx="90" cy="123" rx="15" ry="18" fill="url(#iris)"/>
      <ellipse cx="150" cy="123" rx="15" ry="18" fill="url(#iris)"/>
      <ellipse cx="90" cy="123" rx="4.5" ry="14" fill="#10202c"/>
      <ellipse cx="150" cy="123" rx="4.5" ry="14" fill="#10202c"/>
      <circle cx="96" cy="115" r="4.5" fill="#fff"/>
      <circle cx="156" cy="115" r="4.5" fill="#fff"/>
      <circle cx="86" cy="130" r="2" fill="#fff" opacity=".8"/>
      <circle cx="146" cy="130" r="2" fill="#fff" opacity=".8"/>
      <path d="M111 146h18l-9 11z" fill="#e58fa4"/>
      <path d="M120 157v7M120 164c-6 8-15 8-20 3M120 164c6 8 15 8 20 3" stroke="#4f5660" stroke-width="2.6" stroke-linecap="round" fill="none"/>
      <g stroke="#f2f5f8" stroke-width="1.8" stroke-linecap="round" opacity=".9">
        <path d="M84 160L38 150M84 167L40 172M86 174L48 192"/>
        <path d="M156 160L202 150M156 167L200 172M154 174L192 192"/>
      </g>
    </svg>
  </div>
  <h1 class="sign">Paws &amp; Whiskers</h1>
  <p class="tag">Meet the animals in our class</p>
</header>

<main>
<section class="card">
    <h2 align="center">t1a14-extend-class-by-Sara</h2> 
    Extending a pre-existing Class <br>
    <h4>Example working Classes code</h4> 
    <input type="button" value="Example Class Set and Show Class Animal" onClick="{ 
      class myAnimal { 
        constructor(passName, passAge) { 
          this.myName = passName; 
          this.myAge = passAge; 
        } 
        myShow() { 
          document.getElementById('myDiv01').innerHTML = 'Hello '+ this.myName + '. You are ' + this.myAge + ' years old <br>'; 
        } 
      }
      let myDog = new myAnimal('Snickers', 5); 
      myDog.myShow();
    }"> 
    <h4>Example extending Class code</h4> 
    Nothing: <input type="text" id="myText01" value="Useless at the moment"><br>
    <input type="button" value="Example Extend Class Animal" onClick="{ 
      class myAnimal { 
        constructor(passName, passAge) { 
          this.myName = passName; 
          this.myAge = passAge; 
        } 
        myShow() { 
          document.getElementById('myDiv01').innerHTML = 'Hello '+ this.myName + '<br>'; 
        } 
      }
      class myCat extends myAnimal { 
        myShow() {
          document.getElementById('myDiv01').innerHTML = this.myName + ' is a great cat <br>';
        } 
      } 

      let myPet = new myCat('fluffy', 14);
      myPet.myShow();
    }">
    <div id="myDiv01">...</div>
</section>
</main>

<footer>Paws &amp; Whiskers Pet Shop</footer>
</body>
</html>
